# TES Charger V3 - ESP32-S3 N16R8 default sdkconfig
# Flash: 16MB DIO 80MHz | PSRAM: 8MB OPI | Target: ESP32-S3

# --- Flash ---
# Set the choice symbols (..._DIO=y), not the derived strings (FLASHMODE="dio"):
# the strings are computed from the choice and are silently ignored here. Until
# 2026-10-27 only the strings were set; it worked because DIO / 80 MHz are the
# ESP32-S3 defaults anyway.
# The flash baud rate is not a sdkconfig option in IDF 5.x (CONFIG_ESPTOOLPY_BAUD
# gave "unknown kconfig symbol"): use `idf.py -b 921600 flash` or ESPBAUD=921600.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- Partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# --- PSRAM (OPI 8MB on N16R8) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# WiFi / lwIP buffers and mbedTLS (MQTT, OTA, push) in PSRAM (2026-10-18). Internal RAM ran out:
# min free fell to 276 bytes during a GitHub OTA with MQTT TLS up, which stalled uploads and OTA
# and froze the HTTP server. With both: ~113 KB free, min ~70 KB; 1.5 MB upload in 11 s.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- USB CDC console ---
CONFIG_ESP_CONSOLE_USB_CDC=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# --- WiFi ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# --- TCP window (2026-10-20) ---
# Default 5760 = 4 segments: one lost segment stalls the connection until the retransmit timer,
# which looks like the ~1 s steps on /control and may be behind upload OTA stalling at 9x %.
# 10 segments now that lwIP buffers live in PSRAM (above). Receive mailbox = WND/MSS + 2.
CONFIG_LWIP_TCP_WND_DEFAULT=14400
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=14400
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# --- TWAI (CAN bus) ---
CONFIG_TWAI_ERRATA_FIX_LISTEN_ONLY_DOM=y

# --- Heap ---
CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS=n

# --- App version: set by CMakeLists.txt via git describe, not hardcoded here ---
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n

# App rollback (2026-10-28): a new image boots as PENDING_VERIFY and is marked valid after 30 s
# (ota_svc_boot_check); if it resets before that, the bootloader goes back to the previous one.
# Needs the new bootloader - OTA never updates the bootloader, so only boards flashed over USB
# after this get the automatic part. The manual "back to the previous version" works on all.
# Anti-rollback (eFuse) stays off on purpose.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
